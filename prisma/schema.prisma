generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Quotation {
  id            Int        @id @default(autoincrement())
  model         Auto       @relation(fields: [modelId], references: [id])
  modelId       Int
  fullName      String
  phone         String
  email         String
  acceptsPolicy Boolean
  createdAt     DateTime   @default(now())
  city          City       @relation(fields: [cityId], references: [id])
  cityId        Int
  department    Department @relation(fields: [departmentId], references: [id])
  departmentId  Int
  price         Float
}

model Department {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  cities    City[]
  Quotation Quotation[]
}

model City {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  department   Department  @relation(fields: [departmentId], references: [id])
  departmentId Int
  quotations   Quotation[]
}

model Auto {
  id           Int         @id @default(autoincrement())
  name         String
  price        Float
  image        String
  speed        String
  acceleration String
  maxSpeed     String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  Quotation    Quotation[]

  @@map("autos")
}
